local Start = Button("START", Color3.fromRGB(30, 160, 70), 48)
local Stop = Button("STOP", Color3.fromRGB(190, 50, 50), 88)
local Close = Button("CLOSE", Color3.fromRGB(70, 70, 80), 128)

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -10, 0, 20)
Status.Position = UDim2.new(0, 5, 0, 168)
Status.BackgroundTransparency = 1
Status.Text = "Status: Idle"
Status.TextColor3 = Color3.new(1,1,1)
Status.Font = Enum.Font.Gotham
Status.TextSize = 11
Status.Parent = Frame

-- CHARACTER
local function GetRoot()
    local Character = Player.Character
    if not Character then return nil end
    return Character:FindFirstChild("HumanoidRootPart")
end

-- GET APPLE POSITION
local function GetPosition(Object)
    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then
        local Part = Object.PrimaryPart
            or Object:FindFirstChildWhichIsA("BasePart", true)

        if Part then
            return Part.Position
        end
    end

    return nil
end

-- CHECK APPLE
local function IsApple(Object)
    local Name = Object.Name:lower()

    if not (Object:IsA("BasePart") or Object:IsA("Model")) then
        return false
    end

    return Name:find("apple") ~= nil
end

-- FIND NEAREST APPLE
local function FindApple()
    local Root = GetRoot()
    if not Root then return nil end

    local Nearest = nil
    local Shortest = SEARCH_RADIUS

    for _, Object in ipairs(Workspace:GetDescendants()) do
        if IsApple(Object) then
            local Position = GetPosition(Object)

            if Position then
                local Distance = (Root.Position - Position).Magnitude

                if Distance < Shortest then
                    Shortest = Distance
                    Nearest = Object
                end
            end
        end
    end

    return Nearest
end

-- TELEPORT
local function TeleportToApple(Apple)
    local Root = GetRoot()
    if not Root or not Apple or not Apple.Parent then
        return false
    end

    local Position = GetPosition(Apple)
    if not Position then return false end

    Root.CFrame = CFrame.new(
        Position + Vector3.new(0, TELEPORT_OFFSET, 0)
    )

    return true
end

-- FARM LOOP
local function StartFarm()
    if Running then return end
    Running = true

    task.spawn(function()
        while Running do
            local Apple = FindApple()

            if Apple then
                CurrentApple = Apple
                Status.Text = "Status: Apple found!"

                local Teleported = TeleportToApple(Apple)

                if Teleported then
                    Status.Text = "Status: Teleported!"
                end

                task.wait(1)
            else
                Status.Text = "Status: No apple detected"
                task.wait(SCAN_DELAY)
            end
        end
    end)
end

-- BUTTON EVENTS
Start.MouseButton1Click:Connect(StartFarm)

Stop.MouseButton1Click:Connect(function()
    Running = false
    Status.Text = "Status: Stopped"
end)

Close.MouseButton1Click:Connect(function()
    Running = false
    GUI:Destroy()
end)

print("Apple Ground Locator Loaded!")
