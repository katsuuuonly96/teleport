local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Player = Players.LocalPlayer

local SCAN_RADIUS = 300
local MAX_RESULTS = 100

local function GetRoot()
    local Character = Player.Character
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetPosition(obj)
    if obj:IsA("BasePart") then
        return obj.Position
    elseif obj:IsA("Model") then
        return obj:GetPivot().Position
    end
    return nil
end

local function GetFullPath(obj)
    local path = obj.Name
    local parent = obj.Parent

    while parent and parent ~= Workspace do
        path = parent.Name .. "." .. path
        parent = parent.Parent
    end

    return "Workspace." .. path
end

local function ScanObjects()
    local Root = GetRoot()

    if not Root then
        warn("Character not found!")
        return
    end

    local Results = {}

    print("================================")
    print("ANIME DICE OBJECT SCANNER")
    print("Scanning radius:", SCAN_RADIUS)
    print("================================")

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local pos = GetPosition(obj)

            if pos then
                local distance = (Root.Position - pos).Magnitude

                if distance <= SCAN_RADIUS then
                    local hasPrompt = obj:FindFirstChildWhichIsA(
                        "ProximityPrompt", true
                    ) ~= nil

                    local hasClick = obj:FindFirstChildWhichIsA(
                        "ClickDetector", true
                    ) ~= nil

                    local hasTouch = obj:FindFirstChild("TouchInterest") ~= nil

                    local attributes = {}
                    for name, value in pairs(obj:GetAttributes()) do
                        table.insert(attributes, name .. "=" .. tostring(value))
                    end

                    table.insert(Results, {
                        Object = obj,
                        Name = obj.Name,
                        Class = obj.ClassName,
                        Path = GetFullPath(obj),
                        Distance = distance,
                        Prompt = hasPrompt,
                        Click = hasClick,
                        Touch = hasTouch,
                        Attributes = table.concat(attributes, ", ")
                    })
                end
            end
        end
    end

    table.sort(Results, function(a, b)
        return a.Distance < b.Distance
    end)

    print("OBJECTS FOUND:", #Results)

    for i = 1, math.min(#Results, MAX_RESULTS) do
        local item = Results[i]

        print("--------------------------------")
        print("NUMBER:", i)
        print("NAME:", item.Name)
        print("CLASS:", item.Class)
        print("DISTANCE:", math.floor(item.Distance))
        print("PATH:", item.Path)
        print("PROMPT:", item.Prompt)
        print("CLICK DETECTOR:", item.Click)
        print("TOUCH INTEREST:", item.Touch)
        print("ATTRIBUTES:", item.Attributes)
    end

    print("================================")
    print("SCAN COMPLETE")
    print("================================")
end

ScanObjects()
