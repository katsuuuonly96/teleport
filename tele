local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Player = Players.LocalPlayer

-- SETTINGS
local SEARCH_RADIUS = 1000
local SCAN_DELAY = 0.7
local TELEPORT_OFFSET = 3

local Running = false
local CurrentApple = nil

-- CLEAN OLD GUI
pcall(function()
    game:GetService("CoreGui"):FindFirstChild("AppleGroundLocator"):Destroy()
end)

-- GUI
local GUI = Instance.new("ScreenGui")
GUI.Name = "AppleGroundLocator"
GUI.ResetOnSpawn = false

local success = pcall(function()
    GUI.Parent = game:GetService("CoreGui")
end)

if not success or not GUI.Parent then
    GUI.Parent = Player:WaitForChild("PlayerGui")
end

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 240, 0, 190)
